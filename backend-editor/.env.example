# openRWP editor backend (RWP 0.0.12). Copy to .env and fill in the values. Never commit .env.

PORT=3000
# Public base URL of this service, without trailing slash. The GNR resolver endpoint is <PUBLIC_BASE_URL>/did
PUBLIC_BASE_URL=https://example.org/editor
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- App namespace -------------------------------------------------------------
# A UUIDv4 is a global namespace and is checked against the GNR. Any other value is a local namespace
# and is never sent to the GNR (RWP 4.4).
APP_NAMESPACE=
# RecordIds of the two records created by tools/bootstrap.js
EDITOR_AGENT_ID=
EDITOR_SCHEMA_ID=
# Operator key (Ed25519), created by tools/bootstrap.js. Keep it outside the repository.
OPERATOR_KEY_FILE=/run/secrets/operator-key.json

# --- RecordWeb root records ----------------------------------------------------
ROOT_SCHEMA_DID=did:rwp:d2d14675-50c9-463d-b564-1ea50644c836:1710c421-bb2b-462e-ad6b-fc47c934c276
ROOT_AGENT_SCHEMA_DID=did:rwp:d2d14675-50c9-463d-b564-1ea50644c836:c25a00eb-552e-4696-bed7-69a0839ad460

# --- GNR lookup (same variables as recordFinder) --------------------------------
PEER_ENDPOINT=peer0.tws.rwrrn.recordweb.dev:7051
PEER_HOST_ALIAS=peer0.tws.rwrrn.recordweb.dev
CHANNEL_NAME=rw-gnr-test
CHAINCODE_NAME=namespace-registry
MSP_ID=TWSOrgMSP
ORG_DOMAIN=org.recordweb.dev
ADMIN_IDENTITY=Admin@org.recordweb.dev
CRYPTO_DIR=/crypto/peerOrganizations/org.recordweb.dev
# Host path of the crypto material, mounted read-only to /crypto (see docker-compose)
CRYPTO_CONFIG_HOST_PATH=/opt/rw-rrn/crypto-config
# Optional: only accept namespaces registered by this network identity
GNR_ENDORSER=
